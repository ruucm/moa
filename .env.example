# MOA environment — copy to .env.local (never commit .env.local).
# The easiest setup is `npm run set-password -- <password>`, which writes
# MOA_PASSWORD_HASH and MOA_SECRET for you.

# Owner password hash (scrypt). Generate with: npm run set-password -- <password>
#MOA_PASSWORD_HASH=

# HMAC key for signed cookies (login sessions, share links). set-password
# generates one; rotate it to invalidate every cookie at once.
#MOA_SECRET=

# Disable auth entirely — ONLY for a machine-local, non-exposed instance.
#MOA_NO_AUTH=1

# Where projects/, public/, registry.json live. Defaults to the checkout dir.
#MOA_CONTENT_ROOT=/path/to/content

# Root the folder browser / project registration is confined to.
# Defaults to your home directory.
#MOA_BROWSE_ROOT=/Users/me/work

# Public origin used for OG tags on shared links (set when port-forwarding
# 80 → 5001 so chat-app link previews can fetch the thumbnail).
#MOA_PUBLIC_ORIGIN=http://your-host

# Same-origin proxies to other local dev servers (see next.config.mjs).
#MOA_PROXIES=studio:5300,review:5318
